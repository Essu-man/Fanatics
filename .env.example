# Copy to .env.local and fill in values.

# Firebase (client — already in your app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (required for seller APIs: /api/user/me, /api/vendor/*)
# Option A: path to JSON file in project root (recommended for local dev)
# Download: Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Option B: entire JSON on one line (for hosting)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Option C: discrete fields (e.g. Vercel)
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_PROJECT_ID=your-project-id
